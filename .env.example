# 药品主数据变更听写系统 · 环境变量样例
#
# 复制为 .env 后按院内实际地址填写。代码中零硬编码密钥与端点：
# 所有凭据位一律从环境变量读取，缺失时启动明确报错，不回落本地替身。
#
#   cp .env.example .env

# ---- 主数据系统（出站写回 + 目录同步 + 回执回读）----
# 主数据平台根地址，例如 https://mdm.example-hospital.local
MDM_BASE_URL=
# 访问令牌，Bearer 形式下发；不要提交到版本库
MDM_TOKEN=

# ---- 模型服务（要素抽取，唯一模型调用点）----
# OpenAI 兼容端点根地址，调用路径为 {MODEL_BASE_URL}/v1/chat/completions
MODEL_BASE_URL=
MODEL_API_KEY=
# 参与要素抽取的模型名
MODEL_NAME=
# 模型调用超时（秒）
MODEL_TIMEOUT=30

# ---- 语音识别模式 ----
# local        = 本机离线识别（默认，录音不出本机）
# openai-compatible = 对接院内语音服务，调用 {ASR_BASE_URL}/v1/audio/transcriptions
ASR_MODE=local
ASR_BASE_URL=
ASR_API_KEY=
